# Copy to .env and fill in. NEVER commit .env. chmod 600 .env
# Paper mode needs no keys at all.

# Production (used only by mode: live)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/home/kalshibot/keys/kalshi_prod.pem

# Demo exchange (mode: demo, demo-smoke). Create keys at https://demo.kalshi.co
KALSHI_DEMO_API_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=/home/kalshibot/keys/kalshi_demo.pem
